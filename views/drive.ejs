<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drive</title>
  </head>
  <body>
    <h1>Your Drive</h1>

    <h2>Create a Folder</h2>
    <form action="create-folder" method="post">
      <label for="folder-name-input">Folder Name</label>
      <input type="text" id="folder-name-input" name="name" />
      <button type="submit">Submit</button>
    </form>

    <a href="/upload">Upload a File</a>

    <h2>Folders:</h2>
    <% uploads.folders.forEach((folder) => { %>
    <h3><%= folder.name %></h3>
    <form action="/edit-folder/<%= folder.id %>" method="get">
      <button type="submit">Edit</button>
    </form>
    <form action="/delete-folder/<%= folder.id %>" method="post">
      <button type="submit">Delete</button>
    </form>

    <% uploads.files.forEach((file) => { %> <% if (file.folderId === folder.id)
    { %>
    <p><%= file.name %></p>
    <form action="/file/<%=file.id%>" method="get">
      <button type="submit">View Details</button>
    </form>
    <form action="/download/<%= file.id %>" method="post">
      <button type="submit">Download</button>
    </form>
    <form action="/delete-file/<%=file.id%>" method="post">
      <button type="submit">Delete</button>
    </form>
    <% } %> <% }) %> <% }) %>

    <h2>All Files:</h2>
    <% uploads.files.forEach((file) => { %>
    <p><%= file.name %></p>
    <form action="/file/<%=file.id%>" method="get">
      <button type="submit">View Details</button>
    </form>
    <form action="/download/<%= file.id %>" method="post">
      <button type="submit">Download</button>
    </form>
    <form action="/delete-file/<%=file.id%>" method="post">
      <button type="submit">Delete</button>
    </form>
    <% }) %>
    <a href="/">Go to Home</a>
  </body>
</html>

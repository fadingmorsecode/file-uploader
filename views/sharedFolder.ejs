<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/styles.css" rel="stylesheet" />
    <title>Shared Folder</title>
  </head>
  <body>
    <%- include('header', {user: user}); %>
    <main>
      <h1 class="h1-heading"><%= folder.name %></h1>
      <% if (folder.files.length < 1) { %>
      <h2>Whoops! This folder contains no files</h2>
      <% } %> <% folder.files.forEach((file) => { %>
      <div class="file-details">
        <p><%= file.name %></p>
        <form action="/file/<%= file.id %>" method="get">
          <button id="details-btn" type="submit">View Details</button>
        </form>
        <form action="/download/<%= file.id %>" method="post">
          <button id="details-btn" type="submit">Download</button>
        </form>
      </div>
      <% }) %>
      <div class="promo-div">
        <p>Need storage of your own?</p>
        <a href="/">Log in or Register</a>
      </div>
    </main>
    <%- include('footer'); %>
  </body>
</html>
